# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter / notebooks
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.nbconvert.ipynb

# Environment variables
.env
.env.*

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Coverage / test outputs
.coverage
.coverage.*
htmlcov/

# Data science / model artifacts
*.pkl
*.joblib
*.h5
*.hdf5
*.parquet

# GIF assets (local demo files only)
gifs/*.gif
!gifs/.gitkeep

# Logs and temporary files
*.log
debug.log
*.tmp

# Keep the project dataset tracked
!data/
!data/*.csv

# Optional: if you want to keep additional files in data, list them explicitly
# !data/some_other_file.csv
